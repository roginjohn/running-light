  "square-state": {
    "locked": {
      "overlay": "#0A0514",
      "overlay-opacity": 0.3,
      "icon": "padlock 9x11 px at top-left (replaces screw), #D9C29A",
      "applies": "every square while the light runs (SPINNING, RESOLVING, DOUBLE_RUN); lit and trail squares keep full brightness above the lock layer",
      "cursor": "not-allowed"
    },
    "dimmed": {
      "overlay": "#0A0514",
      "overlay-opacity": 0.55
    },
    "disabled": {
      "overlay": "#2A2438",
      "overlay-opacity": 0.45,
      "pattern": "45deg hatch"
    }
  },
  "gamble-pick": {
    "card": {
      "w": 280,
      "h": 214,
      "radius": 18
    },
    "states": {
      "idle": "night card, 2 px edge #3A2766",
      "hover": "card lightens to #2A1A4E, edge cream",
      "focus": "white 3 px focus ring over 7 px night under-ring",
      "selected": "4 px marigold ring + 'YOUR PICK' tag + check; bulb fully lit in its colour",
      "disabled": "62% grey overlay, during flip animation and after Collect"
    },
    "keys": {
      "R": "pick red",
      "W": "pick white",
      "ArrowLeft/ArrowRight": "move pick",
      "G": "gamble (needs a pick)",
      "Enter": "collect"
    }
  },
  "z": {
    "background": 0,
    "board": 10,
