    "modal": 100,
    "banner": 110,
    "hud-over-scrim": 120,
    "error": 200
  },
  "motion": {
    "button-press": {
      "duration-ms": 80,
      "scale": 0.96,
      "easing": "cubic-bezier(0.3,0,0.7,1)"
    },
    "light-accelerate": {
      "duration-ms": 600,
      "easing": "cubic-bezier(0.55,0,1,0.45)"
    },
    "light-cruise": {
      "speed-squares-per-s": 18,
      "duration-ms": "1500-2500",
      "easing": "linear"
    },
    "light-decelerate": {
      "duration-ms": "1500-2500",
      "easing": "cubic-bezier(0.2,0.6,0.35,1)"
    },
    "light-total": {
      "duration-ms": "4000-6000"
    },
    "trail": {
      "bulbs": 3,
      "opacity": [
        1.0,
        0.55,
        0.3,
        0.12
      ],
      "fade-ms": 180
    },
    "double-run-banner": {
      "duration-ms": 600,
      "easing": "cubic-bezier(0.34,1.56,0.64,1)"
    },
    "second-light": {
      "duration-ms": "2000-3000"
    },
    "win-countup": {
      "max-duration-ms": 1500,
      "easing": "cubic-bezier(0.25,1,0.5,1)"
    },
    "win-small-pulse": {
      "duration-ms": 600,
      "repeat": 3
    },
    "win-big-marquee": {
      "step-ms": 90,
      "duration-ms": 2500
    },
    "win-jackpot-fanfare": {
      "max-duration-ms": 4000,
      "skippable": true
    },
    "loss-fade": {
      "duration-ms": 500,
      "easing": "ease-out"
    },
    "gamble-pick": {
      "duration-ms": 140,
      "easing": "ease-out"
    },
    "gamble-flip": {
      "duration-ms": 1200,
      "alternate-ms": 100,
      "settle-ms": 300
    },
    "square-lock": {
      "duration-ms": 150,
      "easing": "ease-out",
      "note": "lock overlay fades in on START, out when BETTING resumes"
    },
    "modal-in": {
      "duration-ms": 220,
      "easing": "cubic-bezier(0.2,0.8,0.2,1)"
    },
    "toast": {
      "in-ms": 160,
      "hold-ms": 1800,
      "out-ms": 240
    },
    "reduced-motion-light": {
      "duration-ms": 800,
      "steps": 3,
      "easing": "steps(3)"
    }
  },
