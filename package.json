{
  "name": "running-light",
  "version": "1.0.0",
  "private": true,
  "description": "Running Light - perya bulb-track game (play credits only, no real money).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node --test --test-reporter=spec test/unit/",
    "test:unit": "node --test --test-reporter=spec test/unit/",
    "sim": "node scripts/simulate.js",
    "sim:quick": "node scripts/simulate.js --rounds 1000000 --out /tmp/rl-sim",
    "test:ui": "node --test --test-concurrency=1 --test-reporter=spec test/ui/ui.test.js",
    "screenshots": "node test/ui/screenshots-v2.js",
    "tokens": "node scripts/gen-tokens.js",
    "predev": "node scripts/gen-tokens.js",
    "prebuild": "node scripts/gen-tokens.js"
  },
  "devDependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/carter-one": "^5.0.0",
    "@fontsource/lobster": "^5.0.0",
    "@fontsource/nunito": "^5.0.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "puppeteer-core": "^23.0.0",
    "vite": "^5.4.0"
  }
}
