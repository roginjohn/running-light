{
  "$meta": {
    "name": "Running Light redesign v3 tokens",
    "version": "3.0.0-session1",
    "status": "mockup tokens: for review, not yet used by game/",
    "units": "px unless noted; values are for the 1920x1080 reference unless a breakpoint overrides them"
  },
  "color": {
    "bg-page": "#0f1216",
    "bg-frame": "#1a1f26",
    "bg-rail": "#1c222a",
    "divider": "#2a313a",
    "bg-bottombar": "#1f262e",
    "bg-input": "#222a33",
    "border-input": "#2f3742",
    "bg-segment": "#13181e",
    "bg-card": "#20262e",
    "bg-card-pill": "#151a20",
    "bg-panel-navy": "#14294a",
    "border-panel-navy": "#1f3a63",
    "tile": "#232a33",
    "tile-border": "#2a323c",
    "tile-lit": "#e9eef3",
    "tile-trail": "#ffffff",
    "tile-trail-opacity": [0.34, 0.2, 0.1],
    "tile-jackpot": "#14294a",
    "text-primary": "#e6eaee",
    "text-strong": "#ffffff",
    "text-muted": "#8a94a0",
    "text-dim": "#6b7580",
    "text-on-light": "#0f1216",
    "text-on-green": "#06210f",
    "big-number": "#6a7480",
    "big-number-win": "#e6eaee",
    "accent-blue": "#0d6efd",
    "accent-blue-press": "#0b5ed7",
    "accent-blue-text": "#6ea8fe",
    "accent-green": "#16a34a",
    "accent-green-text": "#4ade80",
    "accent-red": "#dc2626",
    "accent-red-text": "#f87171",
    "btn-disabled": "#3a3f45",
    "btn-disabled-text": "#9aa2ab",
    "scrim": "rgba(15,18,22,0.78)",
    "focus-ring": "#ffffff",
    "tier-24": "#8a94a0",
    "tier-96": "#c3cad2",
    "tier-480": "#6ea8fe",
    "tier-960": "#6ea8fe",
    "tier-1920": "#ffffff",
    "gamble-red": "#dc2626",
    "gamble-red-edge": "#a51c1c",
    "gamble-white": "#f1f3f5",
    "gamble-white-edge": "#c5cbd2",
    "chip-1": "#cbd5e1",
    "chip-5": "#dc2626",
    "chip-10": "#0d6efd",
    "chip-25": "#16a34a",
    "chip-50": "#4b5563",
    "chip-edge": "#ffffff",
    "chip-text-dark": "#0f1216",
    "chip-text-light": "#ffffff"
  },
  "font": {
    "sans": "Poppins, \"Segoe UI\", system-ui, -apple-system, Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "mono": "\"JetBrains Mono\", \"Roboto Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "numeric": "tabular-nums on every number (sans and mono)"
  },
  "type": {
    "label-xs": { "size": 11, "weight": 600, "line": 14, "use": "tile square numbers, tiny tags (desktop only, min size)" },
    "label-sm": { "size": 12, "weight": 600, "line": 16, "use": "rail labels, muted lines, pill text" },
    "label-md": { "size": 13, "weight": 600, "line": 18, "use": "body text in panels and dialogs" },
    "label-lg": { "size": 14, "weight": 700, "line": 20, "use": "buttons, segmented control, card values" },
    "title": { "size": 18, "weight": 700, "line": 24, "use": "dialog titles, centre headline" },
    "big-number": { "size": 88, "weight": 600, "line": 92, "family": "mono", "use": "centre multiplier / result, desktop" },
    "big-number-1280": { "size": 64, "weight": 600, "line": 68, "family": "mono" },
    "big-number-768": { "size": 52, "weight": 600, "line": 56, "family": "mono" },
    "tile-mult": { "size": 12, "weight": 700, "line": 14, "min": 10 },
    "min-size": 10
  },
  "space": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40 },
  "radius": { "frame": 8, "tile": 6, "input": 6, "button": 6, "card": 8, "pill": 999, "chip": 999 },
  "border": { "hairline": 1, "focus": 2 },
  "shadow": "none (flat fills only; separation by fill and 1px borders)",
  "size": {
    "rail-width": 230,
    "bottombar-height": 40,
    "segmented-height": 40,
    "input-height": 40,
    "button-primary-height": 52,
    "button-secondary-height": 32,
    "chip": 34,
    "chip-768": 40,
    "pill-height": 24,
    "bet-badge": 18,
    "icon": 18,
    "gamble-disc": 96,
    "gamble-coin": 120
  },
  "layout": {
    "frame-max-width": 1600,
    "frame-max-height": 980,
    "frame-margin-min": 16,
    "track": { "cols": 16, "rows": 11, "squares": 50, "order": "#1 top-left, clockwise", "gap": 6, "pitch-max": 70, "pitch-min": 40 },
    "track-pitch-formula": "pitch = clamp(40, floor(min(trackBoxW / 16, trackBoxH / 11)), 70); tile = pitch - 6",
    "breakpoints": {
      "desktop": { "match": "width >= 1200", "structure": "frame [rail 230 | divider 1 | game] + bottombar 40", "pitch": "70 at 1920x1080, 50 at 1280x720" },
      "tablet-portrait": { "match": "600-1199 and portrait", "structure": "frame [game] / [rail as 2-column control block] / bottombar 40", "pitch": "45 at 768x1024" }
    }
  },
  "motion": {
    "rule": "animate transform and opacity only",
    "light-step": { "property": "opacity", "duration-ms": 0, "note": "lit tile swaps instantly; trail fades via opacity 120 ms" },
    "trail-fade-ms": 120,
    "press-ms": 80,
    "panel-in-ms": 160,
    "gamble-flip-ms": 700,
    "gamble-flip": "transform: rotateY on a single disc element (2 faces, backface-visibility hidden)",
    "payout-count-ms": 600,
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "reduced-motion": "no flip rotation (crossfade 120 ms), light jumps in 3 steps then stops, no count-up"
  },
  "z": { "track": 1, "light-layer": 2, "centre": 3, "toast": 20, "scrim": 30, "dialog": 31 },
  "paytable": [
    { "pays": 1920, "squares": 1, "weight": 1, "numbers": [8] },
    { "pays": 960, "squares": 2, "weight": 2, "numbers": [21, 46] },
    { "pays": 480, "squares": 7, "weight": 4, "numbers": [3, 13, 18, 29, 34, 40, 49] },
    { "pays": 96, "squares": 19, "weight": 20, "numbers": [2, 5, 7, 10, 12, 15, 17, 20, 23, 25, 27, 30, 32, 35, 37, 39, 42, 44, 47] },
    { "pays": 24, "squares": 21, "weight": 80, "numbers": [1, 4, 6, 9, 11, 14, 16, 19, 22, 24, 26, 28, 31, 33, 36, 38, 41, 43, 45, 48, 50] }
  ],
  "rules": {
    "total-weight": 2093,
    "double-run-one-in": 25,
    "max-gambles": 3,
    "gamble-cap": 30000,
    "bet-per-square": [1, 10],
    "bet-per-round-max": 200,
    "chips": [1, 5, 10, 25, 50],
    "start-credits": 1000,
    "refill": "free, to 1,000, when balance < 1 and no round pending"
  }
}
